# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="http://localhost:3000"

# MONGODB_URI: Optional MongoDB Atlas connection string.
# When provided, Mongoose models persist directly to MongoDB Atlas.
# When omitted in preview/development, the platform uses the synchronized persistent file-backed store.
MONGODB_URI="mongodb+srv://riyanmahato40_db_user:1twxqfn2zVDok5hD@cluster0.nrxsgjv.mongodb.net/?appName=Cluster0"

# JWT_SECRET: Server-side secret used for signing admin authentication tokens and CSRF verification.
JWT_SECRET="replace-with-strong-server-secret-in-production"

# RESEND_API_KEY: Optional transactional email provider key for inquiry notifications.
RESEND_API_KEY=""

# NOTIFICATION_EMAIL: Destination address for new quote requests and contact inquiries.
NOTIFICATION_EMAIL="kapilmahato776@gmail.com"
